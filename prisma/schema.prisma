generator client {
  provider = "prisma-client-js"
  seed     = "tsx prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPCION
  PROFESIONAL
  PACIENTE
}

enum AppointmentStatus {
  RESERVADO
  CONFIRMADO
  CANCELADO
  ASISTIDO
  AUSENTE
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

model User {
  id        String              @id @default(cuid())
  email     String              @unique
  password  String
  role      Role                @default(PACIENTE)
  createdAt DateTime            @default(now())
  patient   PatientProfile?
  prof      ProfessionalProfile?
}

model PatientProfile {
  id               String        @id @default(cuid())
  user             User          @relation(fields: [userId], references: [id])
  userId           String        @unique
  nombre           String
  apellido         String
  telefono         String?
  emailNotif       String?
  Appointment      Appointment[]
  dni              String?
  fechaNacimiento  DateTime?
  localidad        String?
  tieneObraSocial  Boolean?      @default(false)
  obraSocialNombre String?
}

model ProfessionalProfile {
  id                  String                @id @default(cuid())
  user                User                  @relation(fields: [userId], references: [id])
  userId              String                @unique
  nombre              String
  apellido            String
  especialidad        String?
  colorAgenda         String?
  availabilities      Availability[]
  appointments        Appointment[]
  fechaNacimiento     DateTime?
  matriculaProvincial String?
  matriculaNacional   String?
  aliasBancario       String?
  // --- CAMBIO: Relación con sus propios servicios ---
  services            ProfessionalService[]
}

// --- CAMBIO: Nuevo modelo para servicios por profesional ---
model ProfessionalService {
  id                  String              @id @default(cuid())
  nombre              String
  duracionMin         Int
  precioBase          Int
  requierePagoPrevio  Boolean             @default(false)
  penalidadPorcentaje Float?              @default(0.5)
  professional        ProfessionalProfile @relation(fields: [professionalId], references: [id])
  professionalId      String
  appointments        Appointment[]

  @@index([professionalId])
}

model Room {
  id             String         @id @default(cuid())
  nombre         String         @unique
  appointments   Appointment[]
  availabilities Availability[]
}

model Availability {
  id             String              @id @default(cuid())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  room           Room?               @relation(fields: [roomId], references: [id])
  roomId         String?
  activaDesde    DateTime?
  activaHasta    DateTime?
}

model Appointment {
  id                    String              @id @default(cuid())
  patient               PatientProfile      @relation(fields: [patientId], references: [id])
  patientId             String
  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id])
  professionalId        String
  
  // --- CAMBIO: Relación con el servicio del profesional ---
  professionalService   ProfessionalService @relation(fields: [professionalServiceId], references: [id])
  professionalServiceId String

  room                  Room?               @relation(fields: [roomId], references: [id])
  roomId                String?
  fecha                 DateTime
  horaFin               DateTime
  estado                AppointmentStatus   @default(RESERVADO)
  createdAt             DateTime            @default(now())
  cancellation          Cancellation?
  payments              Payment[]
}

model Cancellation {
  id               String      @id @default(cuid())
  appointment      Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId    String      @unique
  who              String
  reason           String?
  penalidadCobrada Boolean     @default(false)
  penalidadMonto   Int         @default(0)
  cbuReintegro     String?
  createdAt        DateTime    @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  appointmentId String
  amountService Int           @default(0)
  amountPenalty Int           @default(0)
  amountTotal   Int           @default(0)
  status        PaymentStatus @default(PENDING)
  note          String?
  createdAt     DateTime      @default(now())

  @@index([appointmentId])
}